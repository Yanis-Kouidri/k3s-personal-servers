{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "kubernetes": {
    "fileMatch": ["\\.yaml$"]
  },
  "helm-values": {
    "fileMatch": ["values.yaml$"]
  },
  "regexManagers": [
    {
      "fileMatch": ["(^|/)sonar-values\\.yaml$"],
      "matchStrings": [
        "buildNumber:\\s*\"(?<currentValue>.*?)\""
      ],
      "depNameTemplate": "SonarSource/sonarqube",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "loose"
    }
  ],
  "followTag": "stable"
}
