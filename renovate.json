{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "kubernetes": {
    "fileMatch": ["\\.yaml$"]
  },
  "helm-values": {
    "fileMatch": ["values.yaml$"]
  },
  "regexManagers": [
    {
      "fileMatch": ["(^|/)sonar-values\\.yaml$"],
      "matchStrings": [
        "buildNumber:\\s*\"(?<currentValue>.*?)\""
      ],
      "depNameTemplate": "SonarSource/sonarqube",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "loose"
    }
  ],
  "packageRules": [
    {
      "description": "Force n8n to follow the tag stable because their releases SemVer include pre-releases",
      "matchPackageNames": ["n8nio/n8n"],
      "matchDatasources": ["docker"],
      "followTag": "stable",
      "versioning": "docker"
    }
  ]
}
