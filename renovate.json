{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "timezone": "Europe/Paris",
  "schedule": ["before 6am"],
  "labels": ["renovate", "dependencies"],
  "extends": [
    "config:recommended"
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/^(apps|clusters|infra)/.*\\.yaml$/"
    ]
  },
  "flux": {
    "managerFilePatterns": [
      "/^(apps|infra)/.*\\.yaml$/"
    ]
  },
  "ignorePaths": [
    "**/*.enc.yaml",
    "backups/**"
  ],
  "customManagers": [
    {
      "description": "Tool versions pinned as env vars in CI workflows. The github-actions manager only looks at `uses:` lines, so these need their own manager. Annotate a variable with a `# renovate: datasource=... depName=... [extractVersion=...]` comment on the line above it. extractVersion is set per annotation because the tag formats differ (vX.Y.Z, kustomize/vX.Y.Z, none on PyPI).",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\s+[A-Z_]+: \"(?<currentValue>[^\"]+)\""
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)sonar-values\\.yaml$/"
      ],
      "matchStrings": [
        "buildNumber:\\s*\"(?<currentValue>.*?)\""
      ],
      "depNameTemplate": "SonarSource/sonarqube",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "loose"
    }
  ],
  "platformAutomerge": true,
  "packageRules": [
      {
      "matchUpdateTypes": ["pin", "digest"],
      "automerge": true
    },
    {
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "minimumReleaseAge": "3 days"
    },
    {
      "matchUpdateTypes": ["minor"],
      "automerge": true,
      "minimumReleaseAge": "5 days"
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "The authentik backup and restore-verify images must keep the PostgreSQL major of the server deployed by the authentik chart (17): a newer pg_dump writes archives the server's pg_restore 17 cannot read, so a real restore would fail. Patch and minor 17.x updates still flow. Lift this together with the server's major.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["postgres"],
      "matchFileNames": [
        "apps/authentik/backup-cron-job.yaml",
        "apps/authentik/restore-verify-cron-job.yaml"
      ],
      "allowedVersions": "/^17\\./"
    },
    {
      "matchFileNames": [
        "**/gotk-components.yaml"
      ],
      "enabled": false
    }
  ],
  "vulnerabilityAlerts": {
    "description": "Immediate updates for security vulnerabilities",
    "labels": ["security"],
    "schedule": ["at any time"],
    "minimumReleaseAge": null
  }
}
