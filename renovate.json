{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/\\.yaml$/"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/values.yaml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)sonar-values\\.yaml$/"
      ],
      "matchStrings": [
        "buildNumber:\\s*\"(?<currentValue>.*?)\""
      ],
      "depNameTemplate": "SonarSource/sonarqube",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "loose"
    }
  ]
}
